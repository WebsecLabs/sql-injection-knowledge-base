{
  "name": "sqli-kb-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "SQL Injection Knowledge Base",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:standalone": "cross-env STANDALONE=true astro build && pagefind --site dist",
    "preview": "astro preview",
    "lint": "eslint . && stylelint 'src/**/*.css' && markdownlint 'src/content/**/*.md' && prettier --check .",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css' && markdownlint --fix 'src/content/**/*.md' && prettier --write .",
    "typecheck": "astro check && node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:a11y:headed": "playwright test accessibility.spec.ts --headed",
    "test:all": "npm run test:unit && npm run test:e2e",
    "prepare": "husky"
  },
  "keywords": [
    "SQL Injection",
    "SQLi",
    "Knowledge Base",
    "Security",
    "Web Security"
  ],
  "author": "WebsecLabs",
  "license": "MIT",
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pagefind/default-ui": "^1.6.0",
    "astro": "^7.4.7",
    "pagefind": "^1.6.0",
    "satteri": "^0.11.6"
  },
  "overrides": {
    "yaml": "2.9.1",
    "katex": "^0.19.0",
    "minimatch": "^11.0.3",
    "re2js": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "astro-eslint-parser": "^3.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
