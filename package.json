{
  "name": "sqli-kb-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "SQL Injection Knowledge Base",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:standalone": "cross-env STANDALONE=true astro build && pagefind --site dist",
    "preview": "astro preview",
    "lint": "eslint . && stylelint 'src/**/*.css' && markdownlint 'src/content/**/*.md' && prettier --check .",
    "lint:fix": "eslint --fix . && stylelint --fix 'src/**/*.css' && markdownlint --fix 'src/content/**/*.md' && prettier --write .",
    "typecheck": "astro check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:a11y:headed": "playwright test accessibility.spec.ts --headed",
    "test:all": "npm run test:unit && npm run test:e2e",
    "prepare": "husky"
  },
  "keywords": [
    "SQL Injection",
    "SQLi",
    "Knowledge Base",
    "Security",
    "Web Security"
  ],
  "author": "WebsecLabs",
  "license": "MIT",
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.7",
    "satteri": "^0.10.5"
  },
  "overrides": {
    "yaml": "2.9.1",
    "markdownlint-cli": {
      "js-yaml": "^5.4.3",
      "smol-toml": "^1.9.0"
    },
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "astro-eslint-parser": "^3.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "markdownlint-cli": "^0.49.1",
    "pagefind": "^1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
