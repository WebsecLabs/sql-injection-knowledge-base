---
import { getCollection, type CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { ClientRouter } from "astro:transitions";
import NavBar from "../components/NavBar.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { Font, Image } from "astro:assets";
import websecLogo from "../assets/websec-logo.png";
import { TOC_MIN_HEADINGS } from "../utils/uiConstants";
import SearchModal from "../components/search/SearchModal.astro";
import WebsecBanner from "../components/WebsecBanner.astro";
import { CANONICAL_URL, WEBSEC_BANNER } from "astro:env/server";
import { toCanonicalUrl } from "../utils/siteUtils";

// Import CSS — main.css imports variables, base, layout, navbar, sidebar, components, code, footer.
// toc.css and search-modal.css are additional and imported separately.
import "../styles/main.css";
import "../styles/toc.css";
import "../styles/search-modal.css";

interface Props {
  title: string;
  description?: string;
  showSidebar?: boolean;
  /** Headings for Table of Contents (H2 and H3) */
  tocHeadings?: MarkdownHeading[];
  /** Page type for Open Graph: "website" for homepage, "article" for content pages */
  pageType?: "website" | "article";
  /** Last modified date for article pages (used in OG meta) */
  lastModified?: Date;
  /** Additional CSS class for page-layout div */
  pageClass?: string;
  /** Keep the page out of search indexes (search results, error pages) */
  noindex?: boolean;
  // Allow pages to pass their own collections to avoid duplicate loading
  collections?: {
    mysqlEntries?: CollectionEntry<"mysql">[];
    mariadbEntries?: CollectionEntry<"mariadb">[];
    mssqlEntries?: CollectionEntry<"mssql">[];
    oracleEntries?: CollectionEntry<"oracle">[];
    postgresqlEntries?: CollectionEntry<"postgresql">[];
    extrasEntries?: CollectionEntry<"extras">[];
  };
}

const {
  title,
  description = "The SQL Injection Knowledge Base is a comprehensive reference and educational resource on identifying, testing, and preventing SQL injection vulnerabilities across various database systems.",
  showSidebar = true,
  tocHeadings = [],
  pageType = "website",
  lastModified,
  pageClass = "",
  noindex = false,
  collections,
} = Astro.props;

// Canonical and social URLs always point at the official home (CANONICAL_URL),
// so copies of the site deployed elsewhere do not compete with it in search
const baseUrl = import.meta.env.BASE_URL;
const canonicalURL = toCanonicalUrl(Astro.url.pathname, baseUrl, CANONICAL_URL);
const ogImageURL = toCanonicalUrl(`${baseUrl}og-image.png`, baseUrl, CANONICAL_URL);

// Show TOC only if there are enough headings
const showToc = tocHeadings.length >= TOC_MIN_HEADINGS;

// Load collections only if not provided by the page
const mysqlEntries = collections?.mysqlEntries ?? (await getCollection("mysql"));
const mariadbEntries = collections?.mariadbEntries ?? (await getCollection("mariadb"));
const mssqlEntries = collections?.mssqlEntries ?? (await getCollection("mssql"));
const oracleEntries = collections?.oracleEntries ?? (await getCollection("oracle"));
const postgresqlEntries = collections?.postgresqlEntries ?? (await getCollection("postgresql"));
const extrasEntries = collections?.extrasEntries ?? (await getCollection("extras"));
---

<!doctype html>
<html lang="en" class:list={{ "has-websec-banner": WEBSEC_BANNER }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Preload the body text and code faces so they are ready for first render -->
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: 400 }]} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content="Websec" />

    <!-- Theme initialization - runs before page renders to prevent flash -->
    <script is:inline>
      (function () {
        // Guard: prevent duplicate listeners if script re-executes
        if (window.__themeInitDone) return;
        window.__themeInitDone = true;
        const darkMQ = window.matchMedia("(prefers-color-scheme: dark)");

        // Storage access throws when site data is blocked; fall back to the
        // in-memory choice set by the theme toggle
        function getStoredTheme() {
          try {
            return localStorage.getItem("theme") || window.__themeFallback || null;
          } catch {
            return window.__themeFallback || null;
          }
        }

        function applyTheme() {
          const theme = getStoredTheme();
          const html = document.documentElement;
          if (theme === "dark") {
            html.classList.add("dark");
            html.classList.remove("light");
          } else if (theme === "light") {
            html.classList.add("light");
            html.classList.remove("dark");
          } else {
            // Auto mode: follow system preference
            html.classList.remove("light");
            html.classList.toggle("dark", darkMQ.matches);
          }
        }

        // Apply on initial load
        applyTheme();

        // Re-apply after View Transitions swap to persist theme across navigation
        document.addEventListener("astro:after-swap", applyTheme);

        // React to system preference changes (for auto mode)
        darkMQ.addEventListener("change", function () {
          if (!getStoredTheme()) {
            applyTheme();
          }
        });
      })();
    </script>
    <script>
      import "../scripts/main.ts";
    </script>
    <script>
      import "../scripts/searchModal.ts";
    </script>
    <ClientRouter />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="SQL Injection Knowledge Base" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="SQL Injection Knowledge Base - Comprehensive security documentation"
    />
    <meta property="og:locale" content="en_US" />
    {pageType === "article" && lastModified && (
      <meta property="article:modified_time" content={lastModified.toISOString()} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="SQL Injection Knowledge Base" />

    <style is:global>
      @view-transition {
        navigation: auto;
      }

      /* bottom: 100% puts the link's bottom edge exactly at the top of the page,
         whatever its height; focus slides it down into view */
      .skip-link {
        position: absolute;
        bottom: 100%;
        left: 0;
        background: var(--color-skip-link-bg);
        color: white;
        padding: 8px;
        z-index: var(--z-above-navbar); /* Must be above sticky navbar (z-index: 1000) */
        transition: transform 0.2s;
        text-decoration: none;
        font-weight: bold;
        border-bottom-right-radius: 6px;
      }

      .skip-link:focus {
        transform: translateY(100%);
        outline: 2px solid var(--color-accent);
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <script is:inline>
      document.querySelector(".skip-link")?.addEventListener("click", function () {
        const target = document.getElementById("main-content");
        if (target) {
          target.setAttribute("tabindex", "-1");
          target.focus();
          target.addEventListener(
            "blur",
            function () {
              target.removeAttribute("tabindex");
            },
            { once: true }
          );
        }
      });
    </script>
    <header class="site-header" data-pagefind-ignore="all">
      {WEBSEC_BANNER && <WebsecBanner />}
      <NavBar
        mysqlEntries={mysqlEntries}
        mariadbEntries={mariadbEntries}
        mssqlEntries={mssqlEntries}
        oracleEntries={oracleEntries}
        postgresqlEntries={postgresqlEntries}
        extrasEntries={extrasEntries}
      />
    </header>

    {/* Sidebar overlay and FAB button are outside .page-layout to prevent
         overflow-x: clip from breaking position: fixed on mobile */}
    {showSidebar && <div id="sidebar-overlay" class="sidebar-overlay" aria-hidden="true" />}

    <div class={`page-layout ${showToc ? "with-toc" : ""} ${pageClass}`}>
      {showSidebar && (
        <div data-pagefind-ignore="all">
          <Sidebar
            mysqlEntries={mysqlEntries}
            mariadbEntries={mariadbEntries}
            mssqlEntries={mssqlEntries}
            oracleEntries={oracleEntries}
            postgresqlEntries={postgresqlEntries}
            extrasEntries={extrasEntries}
          />
        </div>
      )}

      <main id="main-content" class="main-content">
        <div class="content-container">
          <slot />
        </div>
      </main>

      {showToc && <TableOfContents headings={tocHeadings} />}
    </div>

    {/* Mobile-only FAB button - outside page-layout to avoid overflow-x: clip
         breaking position: fixed on some browsers */}
    {showSidebar && (
      <div class="button-container" data-pagefind-ignore="all">
        <button
          type="button"
          id="sidebar-toggle"
          class="sidebar-toggle"
          aria-label="Open navigation"
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <div class="hamburger-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </div>
          <div class="close-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="6" y1="6" x2="18" y2="18" />
              <line x1="18" y1="6" x2="6" y2="18" />
            </svg>
          </div>
        </button>
      </div>
    )}

    <footer data-pagefind-ignore="all">
      <div class="container">
        <div class="footer-content">
          <div class="footer-branding">
            <span class="footer-text">Powered by</span>
            <div class="footer-logo">
              <a
                href="https://www.websec.com"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-logo-link"
              >
                <Image
                  src={websecLogo}
                  alt="Websec Logo"
                  class="footer-logo-img"
                  height={34}
                  densities={[1, 2]}
                  format="webp"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <div data-pagefind-ignore="all">
      <SearchModal />
    </div>
  </body>
</html>
