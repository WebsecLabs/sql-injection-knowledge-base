---
interface Props {
  defaultTab?: string;
  /** Accessible name for the tab list */
  label: string;
}

const { defaultTab, label } = Astro.props;
---

<div class="tabs" data-default-tab={defaultTab}>
  <ul class="tab-list" role="tablist" aria-label={label}>
    <slot name="tab-list" />
  </ul>

  <div class="tab-contents">
    <slot />
  </div>
</div>

<script>
  import "../scripts/tabs";
</script>
