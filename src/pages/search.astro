---
import Layout from "../layouts/Layout.astro";
import { loadAllCollections } from "../utils/collectionLoader";
// Bundled with the page so it is served from a hashed, long-cached URL
import "@pagefind/default-ui/css/ui.css";

const collections = await loadAllCollections();
---

<Layout
  title="Search - SQL Injection KB"
  description="Search SQL injection techniques, payloads and functions across MySQL, MariaDB, PostgreSQL, MSSQL and Oracle."
  showSidebar={false}
  collections={collections}
>
  <div class="search-page">
    <h1>Search</h1>
    <div id="pagefind-search"></div>
  </div>

  <script>
    import { PagefindUI } from "@pagefind/default-ui";

    let searchUI: PagefindUI | null = null;

    function initPagefindUI() {
      // This module stays loaded after leaving the page with View
      // Transitions, so only act when the search container is present
      const container = document.getElementById("pagefind-search");
      searchUI?.destroy();
      searchUI = null;
      if (!container) return;

      const base = import.meta.env.BASE_URL;
      searchUI = new PagefindUI({
        element: "#pagefind-search",
        showSubResults: true,
        showImages: false,
        baseUrl: base,
        // The UI is bundled rather than loaded from /pagefind/, so it cannot
        // infer where the search index lives
        bundlePath: `${base}pagefind/`,
      });

      // Apply URL query parameter if present
      const query = new URLSearchParams(window.location.search).get("q");
      if (query) {
        searchUI.triggerSearch(query);
      }
    }

    // Use only astro:page-load — it fires on initial load AND subsequent
    // View Transition navigations
    document.addEventListener("astro:page-load", initPagefindUI);
  </script>
</Layout>

<style>
  .search-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
  }

  h1 {
    margin-bottom: 2rem;
    color: var(--color-primary);
  }

  /* Pagefind UI theme overrides */
  #pagefind-search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-primary);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-background);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-code-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: inherit;
  }
</style>
